---
import Layaout from "../layouts/Layout.astro";


---
<Layaout>
    

  <div class="max-w-5xl mx-auto p-4">
    <a
      href="/registros"
      class="flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-white shadow active:scale-95 mb-3"
    >
      Volver
    </a>

    <h1 class="text-3xl font-bold text-center mb-6">
      Historial de movimientos
    </h1>

    <form
      id="form"
      class="bg-white shadow-md rounded-xl p-6 space-y-4 border border-gray-200"
    >
      <div>
        <label
          for="fecha"
          class="block text-sm font-medium text-gray-700 mb-1"
        >
          Fecha
        </label>

        <input
          type="date"
          id="fecha"
          value="2026-07-18"
          class="w-full rounded-lg border border-gray-300 p-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div>
        <label
          for="local"
          class="block text-sm font-medium text-gray-700 mb-1"
        >
          Local
        </label>

        <select
          id="local"
          class="w-full rounded-lg border border-gray-300 p-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="1">Avícola</option>
          <option value="2">Guernica</option>
        </select>
      </div>

      <div>
        <label
          for="categoria"
          class="block text-sm font-medium text-gray-700 mb-1"
        >
          Categoría
        </label>

        <select name="categoria" id="categoria">
          <option value="pollo">pollo</option>
          <option value="cerdo">cerdo</option>
          <option value="limpieza">limpieza</option>
          <option value="achura">achura</option>
        </select>
      </div>

      <button
        type="submit"
        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition"
      >
        Consultar
      </button>
    </form>

    <div
      id="lista"
      class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"
    ></div>

  </div>


<div id="lista"></div>

</Layout>
<script src="../script/historial-page.ts"></script>