---
---

<div class="min-h-screen bg-gray-100 p-4">
  <div class="max-w-md mx-auto p-4">
    <a
      href="/configuracion"
      class="flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-white shadow active:scale-95 mb-3"
    >
      Configuraciones
    </a>
    <a
      href="/historial"
      class="flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-white shadow active:scale-95 mb-3"
    >
      Historial
    </a>

    <input
      type="date"
      id="fecha"
      class="w-full border rounded-lg p-3 mb-3"
    />

    <select
      id="local"
      class="w-full border rounded-lg p-3 mb-3"
    >
      <option value="2">Granja</option>
      <option value="1">Avícola</option>
    </select>

    <select
      id="categoria"
      class="w-full border rounded-lg p-3 mb-4"
    >
      <option value="pollo">Pollo</option>
      <option value="cerdo">Cerdo</option>
      <option value="achura">Achura</option>
      <option value="limpieza">Limpieza</option>
    </select>

    <button
      id="buscar"
      class="w-full bg-blue-600 text-white rounded-lg p-3 cursor-pointer"
    >
      Buscar
    </button>

    <div id="resultado" class="mt-4 space-y-3"></div>
  </div>
</div>

<script >
import { number } from "astro:schema";

const fecha = document.getElementById('fecha') as HTMLInputElement;
const local = document.getElementById('local') as HTMLSelectElement;
const categoria = document.getElementById('categoria') as HTMLSelectElement;
const buscar = document.getElementById('buscar') as HTMLButtonElement;
const resultado = document.getElementById('resultado') as HTMLDivElement;

buscar.addEventListener('click', async () => {

  resultado.innerHTML = '<p>Cargando...</p>';

  const response = await fetch(
    `/api/stock?fecha=${fecha.value}&local=${local.value}&categoria=${categoria.value}`
  );

  const data = await response.json();

  console.log(data)

  resultado.innerHTML = '';

  if (!data.length) {
    resultado.innerHTML = `
      <div class="bg-white rounded-xl shadow p-4">
        Sin movimientos
      </div>
    `;
    return;
  }

  data.forEach((item:any) => {
  

    if (item.categoria === 'limpieza') {

      resultado.innerHTML += `
        <div class="bg-white rounded-xl shadow p-4">

          <h2 class="text-xl font-bold mb-3">
            ${item.producto}
          </h2>

          <div class="grid grid-cols-2 gap-2 text-sm">

            <div>Inicio:</div>
            <div>${item.inicio}</div>

            <div>Ingresos:</div>
            <div>${item.ingreso}</div>

            <div>Envíos:</div>
            <div>${item.envio}</div>

            <div>Devoluciones:</div>
            <div>${item.devolucion}</div>

            <div class="font-bold text-green-600">
              Total
            </div>

            <div class="font-bold text-green-600">
              ${item.ventas}
            </div>

          </div>

        </div>
      `;

    } else {

      resultado.innerHTML += `
      <div class="bg-white rounded-xl shadow p-4">

        <h2 class="text-xl font-bold mb-3">
          ${item.producto}
        </h2>

        <div class="grid grid-cols-2 gap-2 text-sm">

          <div>Inicio:</div>
          <div>${item.inicio}</div>

          <div>Ingresos:</div>
          <div>
            ${item.ingreso_mostrado}
            ${item.merma > 0
              ? `<span class="text-xs text-gray-500">(${item.ingreso})</span>`
              : ''}
          </div>

          <div>Producción:</div>
          <div>
            ${item.produccion_mostrada}
            ${item.merma > 0
              ? `<span class="text-xs text-gray-500">(${item.produccion})</span>`
              : ''}
          </div>

          <div>Envíos:</div>
          <div>${item.envio}</div>

          <div>Devoluciones:</div>
          <div>${item.devolucion}</div>

          <div class="font-bold">
            Final
          </div>

          <div class="font-bold">
            ${item.final}
          </div>

          ${
            item.merma > 0
              ? `
                <div class="font-bold text-orange-600">
                  Merma
                </div>

                <div class="font-bold text-orange-600">
                  ${item.merma}%
                </div>
              `
              : ''
          }

          <div class="font-bold text-green-600">
            Consumido
          </div>

          <div class="font-bold text-green-600">
            ${item.ventas.toFixed(2)}
          </div>

          <div class="font-bold">
            Fudo
          </div>

          <div>
            <input
              type="number"
              value="${item.fudo ?? 0}"
              data-producto="${item.producto_id}"
              data-consumido="${item.ventas}"
              class="fudo w-full rounded-lg border border-gray-300 p-2"
            />
          </div>

          <button
            class="guardar rounded-lg bg-green-600 px-4 py-2 font-medium text-white active:scale-95"
            data-producto="${item.producto_id}"
          >
            Guardar
          </button>
          <div class="">
          
<div class="flex flex-col gap-1">
  <div class="font-bold">
    Diferencia
  </div>

  <div class="font-bold diferencia ${
    ((item.fudo ?? 0) - item.ventas) >= 0
      ? "text-green-600"
      : "text-red-600"
  }">
    ${((item.fudo ?? 0) - item.ventas).toFixed(2)}
  </div>
</div>


        </div>

      </div>
      `;
    }

  });

document.querySelectorAll(".guardar").forEach((btn)=>{

  btn.addEventListener("click", async()=>{

    alert('Guardado con exito')


    const boton = btn as HTMLButtonElement;


    const card = boton.closest(".bg-white") as HTMLDivElement;


    const input = card.querySelector(".fudo") as HTMLInputElement;


    const producto_id = Number(
      boton.dataset.producto
    );


    const valorFudo = Number(
      input.value
    );


    await actualizarFudo(
      producto_id,
      fecha.value,
      valorFudo,
      Number(local.value)
    );


  });

});

async function actualizarFudo(
  producto_id:number,
  fecha:string,
  valor:number,
  local:number
){

 const response = await fetch("/api/fudo",{

    method:"PUT",

    headers:{
      "Content-Type":"application/json"
    },

    body:JSON.stringify({

      fecha,
      local,
      producto:producto_id,
      valor

    })

 });


 if(!response.ok){
    console.log("Error guardando");
    return;
 }


 console.log(
   await response.json()
 );

}

document.querySelectorAll(".fudo").forEach((input) => {

  input.addEventListener("input", (e) => {

    const target = e.target as HTMLInputElement;

    const consumido = Number(target.dataset.consumido ?? 0);
    const fudo = Number(target.value || 0);

    const diferencia = fudo - consumido;

    const card = target.closest(".bg-white") as HTMLDivElement;
    const diferenciaEl = card.querySelector(".diferencia") as HTMLDivElement;

    diferenciaEl.textContent = diferencia.toFixed(2);

    diferenciaEl.classList.remove(
      "text-red-600",
      "text-green-600"
    );

    diferenciaEl.classList.add(
      diferencia >= 0
        ? "text-green-600"
        : "text-red-600"
    );

  });

});
});







</script>